# Non-secret settings for the Firebase backend. Copy to ".env" in this folder (functions/.env) before deploying.
# SECRETS (Supabase service key, Bolna API key, webhook token, tally sync token) do NOT go here:
# set them with:  firebase functions:secrets:set SUPABASE_SERVICE_KEY   (and the others, see docs/DEPLOY_FIREBASE_BACKEND.md)

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
BOLNA_AGENT_ID=YOUR_BOLNA_AGENT_ID
BOLNA_FROM_NUMBER=

# SAFE START: dry run only logs which invoice WOULD be called. No real automatic calls are made.
AUTO_FOLLOWUP_ENABLED=false
AUTO_FOLLOWUP_DRY_RUN=true
