# Copy this file to ".env" in the SAME folder, fill it in, then run (from the PROJECT ROOT):
#   npx supabase@latest secrets set --env-file supabase\functions\api\.env --project-ref YOUR_PROJECT_REF
# The real ".env" is git-ignored and must never be uploaded or pasted into chat.
# You do NOT set SUPABASE_URL or the service-role key here: Supabase injects them into the function by itself.

# --- Bolna (required for manual calls and scheduled calls) ---
BOLNA_API_KEY=PASTE_BOLNA_API_KEY
BOLNA_AGENT_ID=PASTE_BOLNA_AGENT_ID
BOLNA_FROM_NUMBER=

# --- Tokens you invent yourself (long random strings; see DEPLOY_SUPABASE_FREE.md step 5) ---
WEBHOOK_TOKEN=CHOOSE_A_LONG_RANDOM_STRING
CRON_SECRET=CHOOSE_ANOTHER_LONG_RANDOM_STRING
# Only needed if something pushes snapshots to POST /api/tally-sync. The Windows Tally agent does NOT use it
# (it writes to Supabase directly). Leave empty to keep that endpoint disabled (503), exactly as designed.
TALLY_SYNC_TOKEN=

# --- Firebase (PUBLIC values; the same ones already inside public/index.html) ---
FIREBASE_PROJECT_ID=biocraft-af718
FIREBASE_WEB_API_KEY=PASTE_apiKey_FROM_public_index_html_firebaseConfig

# --- Optional ---
# CORS_ORIGINS=https://biocraft-af718.web.app,https://biocraft-af718.firebaseapp.com

# --- Scheduler safety: DRY RUN only logs which invoice WOULD be called. No real automatic calls. ---
AUTO_FOLLOWUP_ENABLED=false
AUTO_FOLLOWUP_DRY_RUN=true
