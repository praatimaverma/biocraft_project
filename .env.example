PORT=3000

# Bolna (voice agent)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
WEBHOOK_TOKEN=change-me

# Supabase (call history)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Automatic follow-ups
AUTO_FOLLOWUP_DRY_RUN=true
AUTO_FOLLOWUP_ENABLED=false

# ---- Tally sync ----
# PUSH mode (agent on the Tally server sends data here). Use the SAME value in tally-agent/.env.
TALLY_SYNC_TOKEN=change-me-to-a-long-random-string

# PULL mode (this app reads Tally itself over VPN/Tailscale). Leave false if you use the agent.
TALLY_PULL_ENABLED=false
TALLY_URL=http://100.x.y.z:9000
TALLY_COMPANY=
TALLY_SYNC_TIMES=09:00,21:00
TALLY_DEBIT_IS_NEGATIVE=true
