# Copy this file to ".env" (same folder) and fill it in.

# Tally on THIS server. Leave as is if you enabled the XML server on port 9000.
TALLY_URL=http://localhost:9000

# Exact company name as shown in Tally. Leave empty to use whichever company is open.
TALLY_COMPANY=

# Supabase project URL and server-side service role secret. Keep this .env private.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# Optional: restrict the period Tally reports on, format YYYYMMDD.
TALLY_FROM_DATE=
TALLY_TO_DATE=

# Tally exports money owed by customers as NEGATIVE numbers. Set to false if your test shows the opposite.
TALLY_DEBIT_IS_NEGATIVE=true
