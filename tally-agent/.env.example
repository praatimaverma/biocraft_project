# Copy this file to ".env" in the SAME folder and fill it in. Never share or upload the real .env.

# TallyPrime on this server. Leave as is if the XML server is enabled on port 9000.
TALLY_URL=http://localhost:9000

# EXACT company name as shown in Tally (strongly recommended so the right company is always read).
TALLY_COMPANY=

# Supabase project URL and the server-side service_role secret. Keep this .env private.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# Optional: restrict the period Tally reports on, format YYYYMMDD.
TALLY_FROM_DATE=
TALLY_TO_DATE=

# Tally exports money owed by customers as NEGATIVE numbers. Set to false if your test shows the opposite.
TALLY_DEBIT_IS_NEGATIVE=true

# Safety limit for one run (minutes). Windows also stops the task after 55 minutes.
AGENT_MAX_MINUTES=50
